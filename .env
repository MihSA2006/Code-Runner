# API
APP_NAME=CodeRunner
APP_VERSION=1.0.0
DEBUG=True

# Execution limits
MAX_EXECUTION_TIME=60
MAX_MEMORY=128m
MAX_CPU=0.5
MAX_OUTPUT_SIZE=10000
MAX_CONCURRENT_EXECUTIONS=20

# Rate limiting
RATE_LIMIT_EXECUTE=10/minute
RATE_LIMIT_RESULT=60/minute

# Code limits
MAX_CODE_LENGTH=50000
MAX_OUTPUT_LENGTH=10000

# Database
DATABASE_URL=./coderunner.db

# Token expiry (en secondes)
TOKEN_EXPIRY=300

# Cleanup interval (en secondes)
CLEANUP_INTERVAL=60
